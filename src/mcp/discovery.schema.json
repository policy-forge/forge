{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:forge:draft:mcp-project:1",
  "description": "Unapproved engineering draft. Runtime portable-path, physical alias, expected identity, full closure and lifecycle/current approval checks are additionally required. Existing workspace roles are not broadened.",
  "x-qualification": "No schema compilation/admission/runtime/owner acceptance by author",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_key",
    "resources"
  ],
  "properties": {
    "schema_version": {
      "const": "forge.mcp-project/1"
    },
    "project_key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "resources": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "role",
          "path",
          "expected_sha256",
          "native_identity",
          "lifecycle_key",
          "citation_label"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "role": {
            "enum": [
              "policy-source",
              "oscal-catalog-artifact",
              "oscal-component-artifact",
              "mapping-collection",
              "applicability-manifest",
              "applicability-report",
              "trace-report",
              "lifecycle-record",
              "lifecycle-source",
              "oscal-profile-artifact",
              "oscal-ssp-artifact",
              "framework-impact-manifest",
              "successor-map",
              "framework-impact-report",
              "framework-impact-dispositions"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "expected_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "native_identity": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "model",
                  "root_id",
                  "document_version",
                  "oscal_version"
                ],
                "properties": {
                  "model": {
                    "enum": [
                      "catalog",
                      "component-definition",
                      "profile",
                      "system-security-plan",
                      "mapping-collection"
                    ]
                  },
                  "root_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 45
                  },
                  "document_version": {
                    "type": "string",
                    "maxLength": 4096
                  },
                  "oscal_version": {
                    "type": "string",
                    "maxLength": 64
                  }
                }
              }
            ]
          },
          "lifecycle_key": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
              }
            ]
          },
          "citation_label": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          }
        }
      }
    }
  }
}
