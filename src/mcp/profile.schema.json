{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_key",
    "discovery_sha256",
    "enabled_tools",
    "visible_resource_keys",
    "noncurrent_metadata_keys",
    "source_text_keys",
    "schedule_keys",
    "evidence_metadata_keys",
    "static_report_keys",
    "search_index_key",
    "identity_disclosure",
    "approved_current_basis",
    "source_text_mode",
    "schedule_mode",
    "report_content_mode",
    "evidence_bytes",
    "network",
    "process_execution",
    "as_of"
  ],
  "properties": {
    "schema_version": {
      "const": "forge.mcp-visibility/1"
    },
    "project_key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "discovery_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "enabled_tools": {
      "type": "array",
      "minItems": 1,
      "maxItems": 7,
      "uniqueItems": true,
      "items": {
        "enum": [
          "list_policies",
          "search_requirements",
          "get_requirement",
          "trace_control",
          "get_recorded_applicability",
          "get_gap_summary",
          "get_artifact_status"
        ]
      }
    },
    "visible_resource_keys": {
      "type": "array",
      "maxItems": 999,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
      }
    },
    "noncurrent_metadata_keys": {
      "type": "array",
      "maxItems": 999,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
      }
    },
    "source_text_keys": {
      "type": "array",
      "maxItems": 999,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
      }
    },
    "schedule_keys": {
      "type": "array",
      "maxItems": 999,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
      }
    },
    "evidence_metadata_keys": {
      "type": "array",
      "maxItems": 999,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
      }
    },
    "static_report_keys": {
      "type": "array",
      "maxItems": 999,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
      }
    },
    "search_index_key": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        }
      ]
    },
    "identity_disclosure": {
      "const": "bounded-token-only"
    },
    "approved_current_basis": {
      "const": "caller-established-recorded-policy"
    },
    "source_text_mode": {
      "enum": [
        "omit",
        "exact-span-opt-in"
      ]
    },
    "schedule_mode": {
      "enum": [
        "omit",
        "explicit-as-of"
      ]
    },
    "report_content_mode": {
      "const": "minimized-metadata"
    },
    "evidence_bytes": {
      "const": false
    },
    "network": {
      "const": false
    },
    "process_execution": {
      "const": false
    },
    "as_of": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$",
          "description": "Canonical ASCII10-byte YYYY-MM-DD; runtime maintained chrono calendar parse required, no system clock."
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:forge:draft:mcp-visibility:1",
  "description": "Proposed closed disclosure profile. Expected raw hash comes from a trusted caller. Profile bytes, a SHA256 pin, this constant, or self-reported owner/client fields do not authenticate an owner or establish approval. Complete runtime pairing/scope/policy checks required. Explicit date is part of actual raw profile/pin and captured proof, not client authority; complete mode/date/key pairing and calendar/native schedule checks required.",
  "allOf": [
    {
      "if": {
        "required": [
          "schedule_mode"
        ],
        "properties": {
          "schedule_mode": {
            "const": "omit"
          }
        }
      },
      "then": {
        "properties": {
          "as_of": {
            "type": "null"
          },
          "schedule_keys": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "schedule_mode"
        ],
        "properties": {
          "schedule_mode": {
            "const": "explicit-as-of"
          }
        }
      },
      "then": {
        "properties": {
          "as_of": {
            "type": "string",
            "minLength": 10,
            "maxLength": 10,
            "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$",
            "description": "Canonical ASCII10-byte YYYY-MM-DD; runtime maintained chrono calendar parse required, no system clock."
          },
          "schedule_keys": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
