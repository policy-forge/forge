{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_key",
    "resources",
    "companion_resources"
  ],
  "properties": {
    "schema_version": {
      "const": "forge.mcp-project/2"
    },
    "project_key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "resources": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "role",
          "path",
          "expected_sha256",
          "native_identity",
          "lifecycle_key",
          "citation_label"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "role": {
            "enum": [
              "policy-source",
              "oscal-catalog-artifact",
              "oscal-component-artifact",
              "mapping-collection",
              "applicability-manifest",
              "applicability-report",
              "trace-report",
              "lifecycle-record",
              "lifecycle-source",
              "oscal-profile-artifact",
              "oscal-ssp-artifact",
              "framework-impact-manifest",
              "successor-map",
              "framework-impact-report",
              "framework-impact-dispositions"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "expected_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "native_identity": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "model",
                  "root_id",
                  "document_version",
                  "oscal_version"
                ],
                "properties": {
                  "model": {
                    "enum": [
                      "catalog",
                      "component-definition",
                      "profile",
                      "system-security-plan",
                      "mapping-collection"
                    ]
                  },
                  "root_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 45
                  },
                  "document_version": {
                    "type": "string",
                    "maxLength": 4096
                  },
                  "oscal_version": {
                    "type": "string",
                    "maxLength": 64
                  }
                }
              }
            ]
          },
          "lifecycle_key": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
              }
            ]
          },
          "citation_label": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          }
        }
      }
    },
    "companion_resources": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "kind",
              "path",
              "expected_sha256",
              "citation_label",
              "lifecycle_key",
              "bindings"
            ],
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
              },
              "kind": {
                "const": "linkage-manifest"
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "expected_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "citation_label": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
              },
              "lifecycle_key": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
              },
              "bindings": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "requirements",
                  "implementation_resource_key",
                  "local_evidence"
                ],
                "properties": {
                  "requirements": {
                    "type": "array",
                    "maxItems": 64,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "requirement_key",
                        "resource_key",
                        "resolved_catalog_key"
                      ],
                      "properties": {
                        "requirement_key": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
                        },
                        "resource_key": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
                        },
                        "resolved_catalog_key": {
                          "anyOf": [
                            {
                              "type": "null"
                            },
                            {
                              "type": "string",
                              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
                            }
                          ]
                        }
                      }
                    }
                  },
                  "implementation_resource_key": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
                  },
                  "local_evidence": {
                    "type": "array",
                    "maxItems": 1000,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "evidence_key",
                        "resource_key"
                      ],
                      "properties": {
                        "evidence_key": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
                        },
                        "resource_key": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "kind",
              "path",
              "expected_sha256",
              "citation_label",
              "expected_size"
            ],
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
              },
              "kind": {
                "const": "local-evidence"
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "expected_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "citation_label": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
              },
              "expected_size": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10485760
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "kind",
              "path",
              "expected_sha256",
              "citation_label",
              "report_format",
              "workspace_index_key"
            ],
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
              },
              "kind": {
                "const": "static-report"
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "expected_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "citation_label": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
              },
              "report_format": {
                "const": "forge.workspace-report/1"
              },
              "workspace_index_key": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "kind",
              "path",
              "expected_sha256",
              "citation_label"
            ],
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
              },
              "kind": {
                "const": "workspace-index-metadata"
              },
              "path": {
                "const": "forge.workspace.json"
              },
              "expected_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "citation_label": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "kind",
              "path",
              "citation_label",
              "index_format"
            ],
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
              },
              "kind": {
                "const": "search-index"
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "citation_label": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
              },
              "index_format": {
                "const": "forge.mcp-search-index/1"
              }
            }
          }
        ]
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:forge:mcp:discovery-v2:proposal",
  "description": "Closed inert declaration admission only. No held capture, recorded approval, lawful disclosure, native/currentness proof, builder, server activation, or publication authority is constructed."
}
