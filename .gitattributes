# Auto-detect text files and normalize line endings
* text=auto

# Force LF line endings for source files (consistent across all platforms)
*.rs text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.xml text eol=lf
*.snap text eol=lf
*.txt text eol=lf
*.sh text eol=lf

# Official NIST OSCAL release assets are byte-pinned by the provenance manifest.
# This block must remain after *.json text eol=lf: gitattributes is last-match-wins.
# Do not normalize their upstream formatting.
schemas/oscal_*.json -text
tests/fixtures/schemas/** -text
tests/fixtures/xsd/*.xsd -text

# Force CRLF for Windows batch scripts
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files - don't treat as text
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.tar.gz binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary
