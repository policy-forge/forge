+fn pattern_with_identity_escapes(draft: Draft) {
+    let schema = json!({
+        "type": "string",
+        "pattern": r"^(\-?\d+(\.\d+)?),\s*(\-?\d+(\.\d+)?)$"
+    });
+    let canonical = options()
+        .with_draft(draft)
+        .canonicalize(&schema)
+        .expect("canonicalizes");
+    let validator = ::jsonschema::options()
+        .with_draft(draft)
+        .build(&canonical.to_json_schema())
+        .expect("builds");
+    assert!(validator.is_valid(&json!("-1.5, 2")));
+    assert!(!validator.is_valid(&json!("1-5, 2")));
