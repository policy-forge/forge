              {
                "id": "POL-DP-001_smt",
                "name": "statement",
                "prose": "All sensitive data must be classified according to the organizational data classification scheme"
              },
              {
                "id": "POL-DP-001_gdn",
                "name": "guidance",
                "prose": "This section covers data protection and encryption requirements per NIST SP 800-53.\nAll sensitive data must be classified according to the organizational data classification scheme\nData at rest must be encrypted using AES-256 or equivalent per FIPS 140-3\nData in transit must be protected using TLS 1.3 or higher\nEncryption keys must be rotated annually and stored in a hardware security module"
              }
            ],
            "props": [
              {
                "name": "modality",
                "value": "normative"
              },
