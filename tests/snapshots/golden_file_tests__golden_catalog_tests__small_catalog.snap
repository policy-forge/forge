                "rel": "source"
              }
            ],
            "parts": [
              {
                "id": "POL-AC-001_smt",
                "name": "statement",
                "prose": "All users must authenticate using approved multi-factor credentials before accessing any system"
              },
              {
                "id": "POL-AC-001_gdn",
                "name": "guidance",
                "prose": "This section defines access control requirements for organizational systems.\nAll users must authenticate using approved multi-factor credentials before accessing any system\nAccess permissions must follow the principle of least privilege for all user roles\nUser accounts must be reviewed quarterly and inactive accounts disabled after 90 days\nAll authentication events must be logged and retained for a minimum of one year"
              }
            ],
