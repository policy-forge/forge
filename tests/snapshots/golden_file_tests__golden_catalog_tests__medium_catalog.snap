            "parts": [
              {
                "id": "POL-AC-001_smt",
                "name": "statement",
                "prose": "All users must authenticate using approved credentials before accessing any system"
              },
              {
                "id": "POL-AC-001_gdn",
                "name": "guidance",
                "prose": "This section defines access control requirements for all organizational systems.\nAll users must authenticate using approved credentials before accessing any system\nMulti-factor authentication must be enabled for all privileged accounts\nAccess permissions must follow the principle of least privilege\nUser accounts must be reviewed quarterly and inactive accounts disabled after 90 days"
              }
            ],
