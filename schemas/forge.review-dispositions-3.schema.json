{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "forge.review-dispositions/3",
  "title": "forge.review-dispositions/3",
  "description": "Proposed separately closed whole authoring-plan /3 exchange. Inert asserted declarations only; structural shape does not supply native preparation, alias/currentness/capture, authenticated identity or approval. Complete UTF-8 byte limits and all semantic correlations require the typed contract.",
  "$ref": "#/$defs/DispositionsDocument",
  "$defs": {
    "key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "time": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "Disposition": {
      "type": "string",
      "enum": [
        "approve",
        "reject",
        "request-changes",
        "abstain",
        "superseded"
      ]
    },
    "ResponseClassification": {
      "type": "string",
      "enum": [
        "current",
        "stale",
        "foreign",
        "future",
        "late",
        "unassigned",
        "superseded",
        "conflicted"
      ]
    },
    "ItemState": {
      "type": "string",
      "enum": [
        "unassigned",
        "assigned",
        "in-review",
        "conflicted",
        "changes-requested",
        "quorum-met",
        "expired",
        "stale"
      ]
    },
    "RecordedCurrentness": {
      "type": "string",
      "enum": [
        "unverified",
        "recorded-current"
      ]
    },
    "SourcePin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_key",
        "kind",
        "raw_sha256",
        "byte_length",
        "schema_identity",
        "validation_profile",
        "native_model",
        "native_root_uuid"
      ],
      "properties": {
        "artifact_key": {
          "$ref": "#/$defs/key"
        },
        "kind": {
          "enum": [
            "author-project",
            "authoring-pack",
            "gap-report",
            "applicability-manifest",
            "framework",
            "resolved-catalog",
            "mapping-collection",
            "human-clause",
            "stored-plan"
          ]
        },
        "raw_sha256": {
          "$ref": "#/$defs/hash"
        },
        "byte_length": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10485760
        },
        "schema_identity": {
          "anyOf": [
            {
              "enum": [
                "forge.author-project/1",
                "forge.authoring-pack/1",
                "forge.applicability-report/1",
                "forge.applicability/1",
                "forge.authoring-plan/1"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "validation_profile": {
          "enum": [
            "forge.author-project-intrinsic/1",
            "forge.authoring-pack-intrinsic/1",
            "forge.authoring-gap-report-complete/1",
            "forge.authoring-applicability-intrinsic/1",
            "forge.authoring-framework-native/1",
            "forge.authoring-resolved-catalog-native/1",
            "forge.authoring-mapping-native/1",
            "forge.authoring-clause-validated/1",
            "forge.authoring-plan-complete-equality/1"
          ]
        },
        "native_model": {
          "anyOf": [
            {
              "enum": [
                "catalog",
                "profile",
                "mapping-collection"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "native_root_uuid": {
          "anyOf": [
            {
              "$ref": "#/$defs/native_uuid"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "oneOf": [
        {
          "properties": {
            "artifact_key": {
              "const": "authoring:project"
            },
            "kind": {
              "const": "author-project"
            },
            "byte_length": {
              "minimum": 1,
              "maximum": 2097152
            },
            "schema_identity": {
              "const": "forge.author-project/1"
            },
            "validation_profile": {
              "const": "forge.author-project-intrinsic/1"
            },
            "native_model": {
              "type": "null"
            },
            "native_root_uuid": {
              "type": "null"
            }
          }
        },
        {
          "properties": {
            "artifact_key": {
              "const": "authoring:pack"
            },
            "kind": {
              "const": "authoring-pack"
            },
            "byte_length": {
              "minimum": 1,
              "maximum": 2097152
            },
            "schema_identity": {
              "const": "forge.authoring-pack/1"
            },
            "validation_profile": {
              "const": "forge.authoring-pack-intrinsic/1"
            },
            "native_model": {
              "type": "null"
            },
            "native_root_uuid": {
              "type": "null"
            }
          }
        },
        {
          "properties": {
            "artifact_key": {
              "const": "authoring:gap-report"
            },
            "kind": {
              "const": "gap-report"
            },
            "byte_length": {
              "minimum": 1,
              "maximum": 10485760
            },
            "schema_identity": {
              "const": "forge.applicability-report/1"
            },
            "validation_profile": {
              "const": "forge.authoring-gap-report-complete/1"
            },
            "native_model": {
              "type": "null"
            },
            "native_root_uuid": {
              "type": "null"
            }
          }
        },
        {
          "properties": {
            "artifact_key": {
              "const": "authoring:applicability"
            },
            "kind": {
              "const": "applicability-manifest"
            },
            "byte_length": {
              "minimum": 1,
              "maximum": 10485760
            },
            "schema_identity": {
              "const": "forge.applicability/1"
            },
            "validation_profile": {
              "const": "forge.authoring-applicability-intrinsic/1"
            },
            "native_model": {
              "type": "null"
            },
            "native_root_uuid": {
              "type": "null"
            }
          }
        },
        {
          "properties": {
            "artifact_key": {
              "const": "authoring:framework"
            },
            "kind": {
              "const": "framework"
            },
            "byte_length": {
              "minimum": 1,
              "maximum": 10485760
            },
            "schema_identity": {
              "type": "null"
            },
            "validation_profile": {
              "const": "forge.authoring-framework-native/1"
            },
            "native_model": {
              "enum": [
                "catalog",
                "profile"
              ]
            },
            "native_root_uuid": {
              "$ref": "#/$defs/native_uuid"
            }
          }
        },
        {
          "properties": {
            "artifact_key": {
              "const": "authoring:resolved"
            },
            "kind": {
              "const": "resolved-catalog"
            },
            "byte_length": {
              "minimum": 1,
              "maximum": 10485760
            },
            "schema_identity": {
              "type": "null"
            },
            "validation_profile": {
              "const": "forge.authoring-resolved-catalog-native/1"
            },
            "native_model": {
              "enum": [
                "catalog"
              ]
            },
            "native_root_uuid": {
              "$ref": "#/$defs/native_uuid"
            }
          }
        },
        {
          "properties": {
            "artifact_key": {
              "type": "string",
              "pattern": "^authoring:mapping:(?:0|[1-9][0-9]?)$"
            },
            "kind": {
              "const": "mapping-collection"
            },
            "byte_length": {
              "minimum": 1,
              "maximum": 10485760
            },
            "schema_identity": {
              "type": "null"
            },
            "validation_profile": {
              "const": "forge.authoring-mapping-native/1"
            },
            "native_model": {
              "enum": [
                "mapping-collection"
              ]
            },
            "native_root_uuid": {
              "$ref": "#/$defs/native_uuid"
            }
          }
        },
        {
          "properties": {
            "artifact_key": {
              "type": "string",
              "pattern": "^authoring:clause:(?:0|[1-9][0-9]?)$"
            },
            "kind": {
              "const": "human-clause"
            },
            "byte_length": {
              "minimum": 1,
              "maximum": 1048576
            },
            "schema_identity": {
              "type": "null"
            },
            "validation_profile": {
              "const": "forge.authoring-clause-validated/1"
            },
            "native_model": {
              "type": "null"
            },
            "native_root_uuid": {
              "type": "null"
            }
          }
        },
        {
          "properties": {
            "artifact_key": {
              "const": "authoring:plan"
            },
            "kind": {
              "const": "stored-plan"
            },
            "byte_length": {
              "minimum": 1,
              "maximum": 10485760
            },
            "schema_identity": {
              "const": "forge.authoring-plan/1"
            },
            "validation_profile": {
              "const": "forge.authoring-plan-complete-equality/1"
            },
            "native_model": {
              "type": "null"
            },
            "native_root_uuid": {
              "type": "null"
            }
          }
        }
      ]
    },
    "RecordedResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "response_id",
        "raw_sha256",
        "byte_length",
        "item_key",
        "reviewer_key",
        "reviewer_role",
        "disposition",
        "responded_at",
        "classification"
      ],
      "properties": {
        "response_id": {
          "$ref": "#/$defs/uuid"
        },
        "raw_sha256": {
          "$ref": "#/$defs/hash"
        },
        "byte_length": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "item_key": {
          "$ref": "#/$defs/key"
        },
        "reviewer_key": {
          "$ref": "#/$defs/key"
        },
        "reviewer_role": {
          "$ref": "#/$defs/key"
        },
        "disposition": {
          "$ref": "#/$defs/Disposition"
        },
        "responded_at": {
          "$ref": "#/$defs/time"
        },
        "classification": {
          "$ref": "#/$defs/ResponseClassification"
        }
      }
    },
    "MetSeat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role_key",
        "ordinal",
        "reviewer_key",
        "response_id"
      ],
      "properties": {
        "role_key": {
          "$ref": "#/$defs/key"
        },
        "ordinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 99
        },
        "reviewer_key": {
          "$ref": "#/$defs/key"
        },
        "response_id": {
          "$ref": "#/$defs/uuid"
        }
      }
    },
    "UnmetSeat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role_key",
        "ordinal"
      ],
      "properties": {
        "role_key": {
          "$ref": "#/$defs/key"
        },
        "ordinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 99
        }
      }
    },
    "ItemDisposition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_key",
        "item_id",
        "state",
        "reason_codes",
        "required_seats",
        "met_seats",
        "unmet_seats",
        "response_ids",
        "dissent_ids",
        "blocking"
      ],
      "properties": {
        "item_key": {
          "$ref": "#/$defs/key"
        },
        "item_id": {
          "$ref": "#/$defs/uuid"
        },
        "state": {
          "$ref": "#/$defs/ItemState"
        },
        "reason_codes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/key"
          },
          "minItems": 0,
          "maxItems": 32
        },
        "required_seats": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "met_seats": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MetSeat"
          },
          "minItems": 0,
          "maxItems": 100
        },
        "unmet_seats": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/UnmetSeat"
          },
          "minItems": 0,
          "maxItems": 100
        },
        "response_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/uuid"
          },
          "minItems": 0,
          "maxItems": 10000
        },
        "dissent_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/uuid"
          },
          "minItems": 0,
          "maxItems": 10000
        },
        "blocking": {
          "type": "boolean"
        }
      }
    },
    "StateCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unassigned",
        "assigned",
        "in_review",
        "conflicted",
        "changes_requested",
        "quorum_met",
        "expired",
        "stale"
      ],
      "properties": {
        "unassigned": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "assigned": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "in_review": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "conflicted": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "changes_requested": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "quorum_met": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "expired": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "stale": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "DispositionCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items",
        "response_files",
        "unique_responses",
        "exact_duplicates",
        "states"
      ],
      "properties": {
        "items": {
          "const": 1
        },
        "response_files": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "unique_responses": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "exact_duplicates": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "states": {
          "$ref": "#/$defs/StateCounts"
        }
      }
    },
    "DispositionsDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "identity_disclaimer",
        "queue_id",
        "queue_raw_sha256",
        "as_of",
        "currentness",
        "closure_generation",
        "source_pins",
        "responses",
        "items",
        "counts"
      ],
      "properties": {
        "schema_version": {
          "const": "forge.review-dispositions/3"
        },
        "identity_disclaimer": {
          "const": "keys-roles-authors-and-times-are-asserted-not-authenticated-signed-or-non-repudiable"
        },
        "queue_id": {
          "$ref": "#/$defs/uuid"
        },
        "queue_raw_sha256": {
          "$ref": "#/$defs/hash"
        },
        "as_of": {
          "$ref": "#/$defs/time"
        },
        "currentness": {
          "$ref": "#/$defs/RecordedCurrentness"
        },
        "closure_generation": {
          "anyOf": [
            {
              "$ref": "#/$defs/hash"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_pins": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourcePin"
          },
          "minItems": 6,
          "maxItems": 100
        },
        "responses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RecordedResponse"
          },
          "minItems": 0,
          "maxItems": 10000
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ItemDisposition"
          },
          "minItems": 1,
          "maxItems": 1
        },
        "counts": {
          "$ref": "#/$defs/DispositionCounts"
        }
      }
    },
    "native_uuid": {
      "type": "string",
      "minLength": 32,
      "maxLength": 45,
      "pattern": "^(?:[0-9A-Fa-f]{32}|[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}|\\{[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}\\}|urn:uuid:[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12})$"
    }
  }
}
