{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "forge.review-response/1",
  "title": "forge.review-response/1",
  "description": "Inert asserted declarations; schema admission is not authentication, currentness, quorum or domain approval. UTF-8 byte limits and complete structural correlations are enforced by the typed contract.",
  "$ref": "#/$defs/ResponseDocument",
  "$defs": {
    "key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "time": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "SourceModel": {
      "type": "string",
      "enum": [
        "mapping",
        "catalog",
        "profile",
        "resolved-catalog",
        "component-definition",
        "mapping-manifest",
        "applicability-manifest",
        "applicability-report",
        "lifecycle-record"
      ]
    },
    "Domain": {
      "type": "string",
      "enum": [
        "mapping-assertion",
        "applicability-decision"
      ]
    },
    "RequestedAction": {
      "type": "string",
      "enum": [
        "re-review"
      ]
    },
    "Disposition": {
      "type": "string",
      "enum": [
        "approve",
        "reject",
        "request-changes",
        "abstain",
        "superseded"
      ]
    },
    "SourcePin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_key",
        "model",
        "native_root_uuid",
        "raw_sha256",
        "byte_length",
        "schema_identity"
      ],
      "properties": {
        "artifact_key": {
          "$ref": "#/$defs/key"
        },
        "model": {
          "$ref": "#/$defs/SourceModel"
        },
        "native_root_uuid": {
          "anyOf": [
            {
              "$ref": "#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "raw_sha256": {
          "$ref": "#/$defs/hash"
        },
        "byte_length": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10485760
        },
        "schema_identity": {
          "$ref": "#/$defs/version"
        }
      }
    },
    "SupersessionReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "response_id",
        "raw_sha256"
      ],
      "properties": {
        "response_id": {
          "$ref": "#/$defs/uuid"
        },
        "raw_sha256": {
          "$ref": "#/$defs/hash"
        }
      }
    },
    "ResponseDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "identity_disclaimer",
        "response_id",
        "queue_id",
        "queue_raw_sha256",
        "item_key",
        "item_id",
        "domain",
        "adapter_version",
        "requested_action",
        "source_pins",
        "subject_sha256",
        "context_sha256",
        "policy_sha256",
        "reviewer_key",
        "reviewer_role",
        "disposition",
        "responded_at",
        "rationale",
        "abstention_reason",
        "proposed_edit",
        "supersedes"
      ],
      "properties": {
        "schema_version": {
          "const": "forge.review-response/1"
        },
        "identity_disclaimer": {
          "const": "keys-roles-authors-and-times-are-asserted-not-authenticated-signed-or-non-repudiable"
        },
        "response_id": {
          "$ref": "#/$defs/uuid"
        },
        "queue_id": {
          "$ref": "#/$defs/uuid"
        },
        "queue_raw_sha256": {
          "$ref": "#/$defs/hash"
        },
        "item_key": {
          "$ref": "#/$defs/key"
        },
        "item_id": {
          "$ref": "#/$defs/uuid"
        },
        "domain": {
          "$ref": "#/$defs/Domain"
        },
        "adapter_version": {
          "$ref": "#/$defs/version"
        },
        "requested_action": {
          "$ref": "#/$defs/RequestedAction"
        },
        "source_pins": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourcePin"
          },
          "minItems": 1,
          "maxItems": 100
        },
        "subject_sha256": {
          "$ref": "#/$defs/hash"
        },
        "context_sha256": {
          "$ref": "#/$defs/hash"
        },
        "policy_sha256": {
          "$ref": "#/$defs/hash"
        },
        "reviewer_key": {
          "$ref": "#/$defs/key"
        },
        "reviewer_role": {
          "$ref": "#/$defs/key"
        },
        "disposition": {
          "$ref": "#/$defs/Disposition"
        },
        "responded_at": {
          "$ref": "#/$defs/time"
        },
        "rationale": {
          "type": "string",
          "maxLength": 8192
        },
        "abstention_reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/key"
            },
            {
              "type": "null"
            }
          ]
        },
        "proposed_edit": {
          "type": "null"
        },
        "supersedes": {
          "anyOf": [
            {
              "$ref": "#/$defs/SupersessionReference"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    }
  }
}
