{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://policy-forge.github.io/schemas/author-components/1",
  "title": "FORGE explicitly selected authoring components",
  "$comment": "Separate closed extension of author-project/1. Runtime enforces decoded duplicate rejection, null rejection, 2 MiB/depth-32/16 KiB UTF-8 limits, 100000 dependency records, exact pins and reviewed assignments. At most one component per policy/topic. Every declared parameter must be explicitly supplied and used; component defaults never satisfy absent bindings. Reviewer and status metadata are asserted provenance. Protected answer values cannot render. Paths resolve from the project, not the extension directory. Runtime additionally validates calendar-valid RFC3339 timestamps, canonical local paths, source/sidecar correspondence, aliases and Markdown grammar.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_sha256",
    "instances"
  ],
  "properties": {
    "schema_version": {
      "const": "forge.author-components/1"
    },
    "project_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "instances": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/instance"
      }
    }
  },
  "$defs": {
    "key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?!.*(?:\\\\|:|//))(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[/]$).+$"
    },
    "pin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "expected_sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "expected_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer_key",
        "reviewed_at",
        "rationale"
      ],
      "properties": {
        "reviewer_key": {
          "$ref": "#/$defs/key"
        },
        "reviewed_at": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])[Tt ](?:[01][0-9]|2[0-3]):[0-5][0-9]:(?:[0-5][0-9]|60)(?:\\.[0-9]+)?(?:[Zz]|[+\\-\\u2212](?:[01][0-9]|2[0-3]):[0-5][0-9])$(?![\\s\\S])",
          "$comment": "Lexical guard preserves Chrono RFC 3339 spellings, including lowercase t/z, space, leap seconds, Unicode minus, and fractional precision. Runtime validates calendar dates and the 64-byte bound; JSON Schema maxLength counts characters. Standard date-time format assertions are intentionally absent because they can reject these runtime-accepted spellings."
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384,
          "pattern": "[^\\u0009-\\u000d\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200d\\u2028\\u2029\\u202f\\u205f\\u2060-\\u2064\\u3000\\ufeff\\ufff9-\\ufffb]",
          "not": {
            "pattern": "[\\u0000-\\u001f\\u007f-\\u009f\\u061c\\u200e\\u200f\\u202a-\\u202e\\u2066-\\u2069]"
          }
        }
      }
    },
    "value": {
      "oneOf": [
        {
          "$ref": "#/$defs/value_string"
        },
        {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        },
        {
          "type": "boolean"
        },
        {
          "type": "array",
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/value_string"
          }
        }
      ]
    },
    "value_string": {
      "type": "string",
      "maxLength": 16384,
      "not": {
        "pattern": "[\\u0000-\\u001f\\u007f-\\u009f\\u061c\\u200e\\u200f\\u202a-\\u202e\\u2066-\\u2069]"
      }
    },
    "binding": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value",
            "sensitivity"
          ],
          "properties": {
            "kind": {
              "const": "literal"
            },
            "value": {
              "$ref": "#/$defs/value"
            },
            "sensitivity": {
              "enum": [
                "public",
                "internal"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "question_key",
            "answer_key",
            "expected_sha256"
          ],
          "properties": {
            "kind": {
              "const": "answer"
            },
            "question_key": {
              "$ref": "#/$defs/key"
            },
            "answer_key": {
              "$ref": "#/$defs/key"
            },
            "expected_sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        }
      ]
    },
    "instance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instance_key",
        "policy_key",
        "topic_key",
        "gap_ids",
        "component_manifest",
        "source",
        "parameters",
        "review"
      ],
      "properties": {
        "instance_key": {
          "$ref": "#/$defs/key"
        },
        "policy_key": {
          "$ref": "#/$defs/key"
        },
        "topic_key": {
          "$ref": "#/$defs/key"
        },
        "gap_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/sha256"
          }
        },
        "component_manifest": {
          "allOf": [
            {
              "$ref": "#/$defs/pin"
            },
            {
              "properties": {
                "path": {
                  "pattern": "\\.json$"
                }
              }
            }
          ]
        },
        "source": {
          "allOf": [
            {
              "$ref": "#/$defs/pin"
            },
            {
              "properties": {
                "path": {
                  "pattern": "\\.md$"
                }
              }
            }
          ]
        },
        "parameters": {
          "type": "object",
          "maxProperties": 128,
          "propertyNames": {
            "$ref": "#/$defs/key"
          },
          "additionalProperties": {
            "$ref": "#/$defs/binding"
          }
        },
        "review": {
          "$ref": "#/$defs/review"
        }
      }
    }
  }
}
