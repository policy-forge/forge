{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://policy-forge.github.io/schemas/author-project/1",
  "title": "FORGE author-project Phase 1",
  "description": "Local Phase 1 technical contract. Runtime additionally rejects decoded duplicate keys, noncanonical paths, duplicate logical keys/edges, invalid reference and constraint relationships, and enforces exact input pins. Reviewer metadata is provenance only.",
  "$comment": "Runtime enforces a 2 MiB byte limit, depth 32, 16 KiB UTF-8 string bound, and semantic validation beyond JSON Schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_key",
    "project_root",
    "baseline",
    "applicability_manifest",
    "gap_report",
    "authoring_pack",
    "as_of",
    "reviewers",
    "baseline_review",
    "policies",
    "answers",
    "deferrals",
    "human_clauses"
  ],
  "properties": {
    "schema_version": {
      "const": "forge.author-project/1"
    },
    "project_key": {
      "$ref": "#/$defs/key"
    },
    "project_root": {
      "const": "."
    },
    "baseline": {
      "$ref": "#/$defs/baseline"
    },
    "applicability_manifest": {
      "$ref": "#/$defs/pinned_file"
    },
    "gap_report": {
      "$ref": "#/$defs/pinned_file"
    },
    "authoring_pack": {
      "$ref": "#/$defs/pinned_file"
    },
    "as_of": {
      "$ref": "#/$defs/timestamp"
    },
    "reviewers": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/reviewer"
      }
    },
    "baseline_review": {
      "$ref": "#/$defs/review"
    },
    "policies": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/policy"
      }
    },
    "answers": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "$ref": "#/$defs/answer"
      }
    },
    "deferrals": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/deferral"
      }
    },
    "human_clauses": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/human_clause"
      }
    }
  },
  "$defs": {
    "key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "maxLength": 64
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?!.*(?:\\\\|:|//))(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[/]$).+$"
    },
    "value": {
      "oneOf": [
        {
          "type": "string",
          "maxLength": 16384
        },
        {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        },
        {
          "type": "boolean"
        },
        {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "string",
            "maxLength": 16384
          }
        }
      ]
    },
    "sensitivity": {
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted"
      ]
    },
    "pinned_file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "expected_sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "expected_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "framework_sha256",
        "report_sha256"
      ],
      "properties": {
        "framework_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "resolved_catalog_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "report_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "name"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/key"
        },
        "name": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer_key",
        "reviewed_at",
        "rationale"
      ],
      "properties": {
        "reviewer_key": {
          "$ref": "#/$defs/key"
        },
        "reviewed_at": {
          "$ref": "#/$defs/timestamp"
        },
        "rationale": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "content_rights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_label",
        "statement",
        "review"
      ],
      "properties": {
        "source_label": {
          "$ref": "#/$defs/text"
        },
        "statement": {
          "$ref": "#/$defs/text"
        },
        "review": {
          "$ref": "#/$defs/review"
        }
      }
    },
    "topic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "title",
        "order",
        "question_keys"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/key"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "order": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "question_keys": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/key"
          },
          "uniqueItems": true
        }
      }
    },
    "policy_family": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "title"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/key"
        },
        "title": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "control_assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "control_id",
        "topic_key",
        "review"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/key"
        },
        "control_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^\\S+$"
        },
        "topic_key": {
          "$ref": "#/$defs/key"
        },
        "review": {
          "$ref": "#/$defs/review"
        }
      }
    },
    "family_assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "topic_key",
        "policy_family_key",
        "review"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/key"
        },
        "topic_key": {
          "$ref": "#/$defs/key"
        },
        "policy_family_key": {
          "$ref": "#/$defs/key"
        },
        "review": {
          "$ref": "#/$defs/review"
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "policy_family_key",
        "title"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/key"
        },
        "policy_family_key": {
          "$ref": "#/$defs/key"
        },
        "title": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "answer_pin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "answer_key",
        "expected_sha256"
      ],
      "properties": {
        "answer_key": {
          "$ref": "#/$defs/key"
        },
        "expected_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "deferral": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "gap_id",
        "review"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/key"
        },
        "gap_id": {
          "$ref": "#/$defs/sha256"
        },
        "review": {
          "$ref": "#/$defs/review"
        },
        "revisit_date": {
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    },
    "human_clause": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "policy_key",
        "topic_key",
        "gap_ids",
        "answer_refs",
        "source",
        "review"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/key"
        },
        "policy_key": {
          "$ref": "#/$defs/key"
        },
        "topic_key": {
          "$ref": "#/$defs/key"
        },
        "gap_ids": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/sha256"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "answer_refs": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/answer_pin"
          }
        },
        "source": {
          "$ref": "#/$defs/pinned_file"
        },
        "review": {
          "$ref": "#/$defs/review"
        }
      }
    },
    "question_constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "min_length": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16384
        },
        "max_length": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16384
        },
        "minimum": {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        },
        "maximum": {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        },
        "min_items": {
          "type": "integer",
          "minimum": 0,
          "maximum": 128
        },
        "max_items": {
          "type": "integer",
          "minimum": 0,
          "maximum": 128
        },
        "regex": {
          "type": "string",
          "maxLength": 1024
        },
        "allowed_values": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/value"
          },
          "uniqueItems": true
        }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "prompt",
        "type",
        "required",
        "owner",
        "sensitivity",
        "source_label",
        "constraints"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/key"
        },
        "prompt": {
          "$ref": "#/$defs/text"
        },
        "type": {
          "enum": [
            "string",
            "integer",
            "boolean",
            "string-list"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "owner": {
          "$ref": "#/$defs/key"
        },
        "sensitivity": {
          "$ref": "#/$defs/sensitivity"
        },
        "source_label": {
          "$ref": "#/$defs/text"
        },
        "max_age_days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 36500
        },
        "constraints": {
          "$ref": "#/$defs/question_constraints"
        }
      }
    },
    "answer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "question_key",
        "question_sha256",
        "authoring_pack_sha256",
        "owner",
        "source_label",
        "sensitivity",
        "review",
        "state"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/key"
        },
        "question_key": {
          "$ref": "#/$defs/key"
        },
        "question_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "authoring_pack_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "owner": {
          "$ref": "#/$defs/key"
        },
        "source_label": {
          "$ref": "#/$defs/text"
        },
        "sensitivity": {
          "$ref": "#/$defs/sensitivity"
        },
        "review": {
          "$ref": "#/$defs/review"
        },
        "expires_at": {
          "$ref": "#/$defs/timestamp"
        },
        "state": {
          "enum": [
            "provided",
            "no-answer"
          ]
        },
        "value": {
          "$ref": "#/$defs/value"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "provided"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "required": [
              "value"
            ]
          },
          "else": {
            "not": {
              "required": [
                "value"
              ]
            }
          }
        }
      ]
    }
  }
}
