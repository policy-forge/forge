{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "forge.review-queue/3",
  "title": "forge.review-queue/3",
  "description": "Proposed separately closed whole authoring-plan /3 exchange. Inert asserted declarations only; structural shape does not supply native preparation, alias/currentness/capture, authenticated identity or approval. Complete UTF-8 byte limits and all semantic correlations require the typed contract.",
  "$ref": "#/$defs/QueueDocument",
  "$defs": {
    "key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "subject": {
      "type": "string",
      "pattern": "^authoring-plan:[0-9a-f]{64}$"
    },
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "time": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "Domain": {
      "const": "authoring-plan"
    },
    "RequestedAction": {
      "type": "string",
      "enum": [
        "re-review"
      ]
    },
    "Sensitivity": {
      "type": "string",
      "enum": [
        "ids-and-hashes"
      ]
    },
    "AbstentionRule": {
      "type": "string",
      "enum": [
        "nonapproving"
      ]
    },
    "AuthorSeparation": {
      "type": "string",
      "enum": [
        "declared-keys"
      ]
    },
    "SourcePin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_key",
        "kind",
        "raw_sha256",
        "byte_length",
        "schema_identity",
        "validation_profile",
        "native_model",
        "native_root_uuid"
      ],
      "properties": {
        "artifact_key": {
          "$ref": "#/$defs/key"
        },
        "kind": {
          "enum": [
            "author-project",
            "authoring-pack",
            "gap-report",
            "applicability-manifest",
            "framework",
            "resolved-catalog",
            "mapping-collection",
            "human-clause",
            "stored-plan"
          ]
        },
        "raw_sha256": {
          "$ref": "#/$defs/hash"
        },
        "byte_length": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10485760
        },
        "schema_identity": {
          "anyOf": [
            {
              "enum": [
                "forge.author-project/1",
                "forge.authoring-pack/1",
                "forge.applicability-report/1",
                "forge.applicability/1",
                "forge.authoring-plan/1"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "validation_profile": {
          "enum": [
            "forge.author-project-intrinsic/1",
            "forge.authoring-pack-intrinsic/1",
            "forge.authoring-gap-report-complete/1",
            "forge.authoring-applicability-intrinsic/1",
            "forge.authoring-framework-native/1",
            "forge.authoring-resolved-catalog-native/1",
            "forge.authoring-mapping-native/1",
            "forge.authoring-clause-validated/1",
            "forge.authoring-plan-complete-equality/1"
          ]
        },
        "native_model": {
          "anyOf": [
            {
              "enum": [
                "catalog",
                "profile",
                "mapping-collection"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "native_root_uuid": {
          "anyOf": [
            {
              "$ref": "#/$defs/native_uuid"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "oneOf": [
        {
          "properties": {
            "artifact_key": {
              "const": "authoring:project"
            },
            "kind": {
              "const": "author-project"
            },
            "byte_length": {
              "minimum": 1,
              "maximum": 2097152
            },
            "schema_identity": {
              "const": "forge.author-project/1"
            },
            "validation_profile": {
              "const": "forge.author-project-intrinsic/1"
            },
            "native_model": {
              "type": "null"
            },
            "native_root_uuid": {
              "type": "null"
            }
          }
        },
        {
          "properties": {
            "artifact_key": {
              "const": "authoring:pack"
            },
            "kind": {
              "const": "authoring-pack"
            },
            "byte_length": {
              "minimum": 1,
              "maximum": 2097152
            },
            "schema_identity": {
              "const": "forge.authoring-pack/1"
            },
            "validation_profile": {
              "const": "forge.authoring-pack-intrinsic/1"
            },
            "native_model": {
              "type": "null"
            },
            "native_root_uuid": {
              "type": "null"
            }
          }
        },
        {
          "properties": {
            "artifact_key": {
              "const": "authoring:gap-report"
            },
            "kind": {
              "const": "gap-report"
            },
            "byte_length": {
              "minimum": 1,
              "maximum": 10485760
            },
            "schema_identity": {
              "const": "forge.applicability-report/1"
            },
            "validation_profile": {
              "const": "forge.authoring-gap-report-complete/1"
            },
            "native_model": {
              "type": "null"
            },
            "native_root_uuid": {
              "type": "null"
            }
          }
        },
        {
          "properties": {
            "artifact_key": {
              "const": "authoring:applicability"
            },
            "kind": {
              "const": "applicability-manifest"
            },
            "byte_length": {
              "minimum": 1,
              "maximum": 10485760
            },
            "schema_identity": {
              "const": "forge.applicability/1"
            },
            "validation_profile": {
              "const": "forge.authoring-applicability-intrinsic/1"
            },
            "native_model": {
              "type": "null"
            },
            "native_root_uuid": {
              "type": "null"
            }
          }
        },
        {
          "properties": {
            "artifact_key": {
              "const": "authoring:framework"
            },
            "kind": {
              "const": "framework"
            },
            "byte_length": {
              "minimum": 1,
              "maximum": 10485760
            },
            "schema_identity": {
              "type": "null"
            },
            "validation_profile": {
              "const": "forge.authoring-framework-native/1"
            },
            "native_model": {
              "enum": [
                "catalog",
                "profile"
              ]
            },
            "native_root_uuid": {
              "$ref": "#/$defs/native_uuid"
            }
          }
        },
        {
          "properties": {
            "artifact_key": {
              "const": "authoring:resolved"
            },
            "kind": {
              "const": "resolved-catalog"
            },
            "byte_length": {
              "minimum": 1,
              "maximum": 10485760
            },
            "schema_identity": {
              "type": "null"
            },
            "validation_profile": {
              "const": "forge.authoring-resolved-catalog-native/1"
            },
            "native_model": {
              "enum": [
                "catalog"
              ]
            },
            "native_root_uuid": {
              "$ref": "#/$defs/native_uuid"
            }
          }
        },
        {
          "properties": {
            "artifact_key": {
              "type": "string",
              "pattern": "^authoring:mapping:(?:0|[1-9][0-9]?)$"
            },
            "kind": {
              "const": "mapping-collection"
            },
            "byte_length": {
              "minimum": 1,
              "maximum": 10485760
            },
            "schema_identity": {
              "type": "null"
            },
            "validation_profile": {
              "const": "forge.authoring-mapping-native/1"
            },
            "native_model": {
              "enum": [
                "mapping-collection"
              ]
            },
            "native_root_uuid": {
              "$ref": "#/$defs/native_uuid"
            }
          }
        },
        {
          "properties": {
            "artifact_key": {
              "type": "string",
              "pattern": "^authoring:clause:(?:0|[1-9][0-9]?)$"
            },
            "kind": {
              "const": "human-clause"
            },
            "byte_length": {
              "minimum": 1,
              "maximum": 1048576
            },
            "schema_identity": {
              "type": "null"
            },
            "validation_profile": {
              "const": "forge.authoring-clause-validated/1"
            },
            "native_model": {
              "type": "null"
            },
            "native_root_uuid": {
              "type": "null"
            }
          }
        },
        {
          "properties": {
            "artifact_key": {
              "const": "authoring:plan"
            },
            "kind": {
              "const": "stored-plan"
            },
            "byte_length": {
              "minimum": 1,
              "maximum": 10485760
            },
            "schema_identity": {
              "const": "forge.authoring-plan/1"
            },
            "validation_profile": {
              "const": "forge.authoring-plan-complete-equality/1"
            },
            "native_model": {
              "type": "null"
            },
            "native_root_uuid": {
              "type": "null"
            }
          }
        }
      ]
    },
    "RoleDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/key"
        }
      }
    },
    "Reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "role_keys"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/key"
        },
        "role_keys": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/key"
          },
          "minItems": 1,
          "maxItems": 32
        }
      }
    },
    "SeatRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role_key",
        "count"
      ],
      "properties": {
        "role_key": {
          "$ref": "#/$defs/key"
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "Substitution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seat_role",
        "reviewer_key",
        "asserted_role",
        "reason_code"
      ],
      "properties": {
        "seat_role": {
          "$ref": "#/$defs/key"
        },
        "reviewer_key": {
          "$ref": "#/$defs/key"
        },
        "asserted_role": {
          "$ref": "#/$defs/key"
        },
        "reason_code": {
          "$ref": "#/$defs/key"
        }
      }
    },
    "ReviewPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "seats",
        "substitutions",
        "abstention_rule",
        "empty_abstention_reasons",
        "author_separation"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/key"
        },
        "seats": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SeatRequirement"
          },
          "minItems": 1,
          "maxItems": 32
        },
        "substitutions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Substitution"
          },
          "minItems": 0,
          "maxItems": 3200
        },
        "abstention_rule": {
          "$ref": "#/$defs/AbstentionRule"
        },
        "empty_abstention_reasons": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/key"
          },
          "minItems": 0,
          "maxItems": 32
        },
        "author_separation": {
          "$ref": "#/$defs/AuthorSeparation"
        }
      }
    },
    "Assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer_key",
        "role_key"
      ],
      "properties": {
        "reviewer_key": {
          "$ref": "#/$defs/key"
        },
        "role_key": {
          "$ref": "#/$defs/key"
        }
      }
    },
    "ContextSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason_codes",
        "related_subject_ids"
      ],
      "properties": {
        "reason_codes": {
          "type": "array",
          "prefixItems": [
            {
              "const": "authoring-plan-current"
            }
          ],
          "items": false,
          "minItems": 1,
          "maxItems": 1
        },
        "related_subject_ids": {
          "type": "array",
          "items": false,
          "minItems": 0,
          "maxItems": 0
        }
      }
    },
    "ReviewItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "item_id",
        "domain",
        "adapter_version",
        "subject_id",
        "requested_action",
        "source_keys",
        "subject_sha256",
        "context",
        "context_sha256",
        "policy_key",
        "policy_sha256",
        "author_keys",
        "assignments",
        "due_at",
        "allowed_dispositions"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/key"
        },
        "item_id": {
          "$ref": "#/$defs/uuid"
        },
        "domain": {
          "$ref": "#/$defs/Domain"
        },
        "adapter_version": {
          "const": "forge.authoring-plan-review/1"
        },
        "subject_id": {
          "$ref": "#/$defs/subject"
        },
        "requested_action": {
          "$ref": "#/$defs/RequestedAction"
        },
        "source_keys": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/key"
          },
          "minItems": 6,
          "maxItems": 100
        },
        "subject_sha256": {
          "$ref": "#/$defs/hash"
        },
        "context": {
          "$ref": "#/$defs/ContextSnapshot"
        },
        "context_sha256": {
          "$ref": "#/$defs/hash"
        },
        "policy_key": {
          "$ref": "#/$defs/key"
        },
        "policy_sha256": {
          "$ref": "#/$defs/hash"
        },
        "author_keys": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/key"
          },
          "minItems": 1,
          "maxItems": 100
        },
        "assignments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Assignment"
          },
          "minItems": 0,
          "maxItems": 3200
        },
        "due_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/time"
            },
            {
              "type": "null"
            }
          ]
        },
        "allowed_dispositions": {
          "type": "array",
          "prefixItems": [
            {
              "const": "approve"
            },
            {
              "const": "reject"
            },
            {
              "const": "request-changes"
            },
            {
              "const": "abstain"
            },
            {
              "const": "superseded"
            }
          ],
          "items": false,
          "minItems": 5,
          "maxItems": 5
        }
      }
    },
    "QueueDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "identity_disclaimer",
        "sensitivity",
        "queue_id",
        "created_at",
        "source_pins",
        "roles",
        "reviewers",
        "policies",
        "items"
      ],
      "properties": {
        "schema_version": {
          "const": "forge.review-queue/3"
        },
        "identity_disclaimer": {
          "const": "keys-roles-authors-and-times-are-asserted-not-authenticated-signed-or-non-repudiable"
        },
        "sensitivity": {
          "$ref": "#/$defs/Sensitivity"
        },
        "queue_id": {
          "$ref": "#/$defs/uuid"
        },
        "created_at": {
          "$ref": "#/$defs/time"
        },
        "source_pins": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourcePin"
          },
          "minItems": 6,
          "maxItems": 100
        },
        "roles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RoleDefinition"
          },
          "minItems": 1,
          "maxItems": 32
        },
        "reviewers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Reviewer"
          },
          "minItems": 1,
          "maxItems": 100
        },
        "policies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ReviewPolicy"
          },
          "minItems": 1,
          "maxItems": 1
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ReviewItem"
          },
          "minItems": 1,
          "maxItems": 1
        }
      }
    },
    "native_uuid": {
      "type": "string",
      "minLength": 32,
      "maxLength": 45,
      "pattern": "^(?:[0-9A-Fa-f]{32}|[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}|\\{[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}\\}|urn:uuid:[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12})$"
    }
  }
}
