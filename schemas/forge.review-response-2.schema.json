{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "forge.review-response/2",
  "title": "forge.review-response/2",
  "description": "Proposed separately closed Lifecycle-only /2 exchange. Inert asserted declarations; validation profiles distinguish intrinsic record checks, opaque bytes and generated model/root/UUID identity checks. Structural or schema admission confers no capture, currentness, authentication or native approval. Complete UTF-8 byte limits, ordering, roster and binding correlations require the typed contract.",
  "$ref": "#/$defs/ResponseDocument",
  "$defs": {
    "key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "time": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "Domain": {
      "const": "lifecycle-policy-version"
    },
    "RequestedAction": {
      "type": "string",
      "enum": [
        "re-review"
      ]
    },
    "Disposition": {
      "type": "string",
      "enum": [
        "approve",
        "reject",
        "request-changes",
        "abstain",
        "superseded"
      ]
    },
    "SourcePin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_key",
        "kind",
        "raw_sha256",
        "byte_length",
        "schema_identity",
        "validation_profile",
        "native_model",
        "native_root_uuid"
      ],
      "properties": {
        "artifact_key": {
          "$ref": "#/$defs/key"
        },
        "kind": {
          "enum": [
            "lifecycle-record",
            "opaque-source",
            "generated-artifact"
          ]
        },
        "raw_sha256": {
          "$ref": "#/$defs/hash"
        },
        "byte_length": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10485760
        },
        "schema_identity": {
          "anyOf": [
            {
              "const": "forge.policy-lifecycle/2"
            },
            {
              "type": "null"
            }
          ]
        },
        "validation_profile": {
          "enum": [
            "forge.lifecycle-record-intrinsic/1",
            "forge.opaque-source-bytes/1",
            "forge.lifecycle-generated-identity/1"
          ]
        },
        "native_model": {
          "anyOf": [
            {
              "enum": [
                "catalog",
                "profile",
                "component-definition",
                "mapping-collection",
                "system-security-plan",
                "plan-of-action-and-milestones"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "native_root_uuid": {
          "anyOf": [
            {
              "$ref": "#/$defs/native_uuid"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "oneOf": [
        {
          "properties": {
            "artifact_key": {
              "const": "lifecycle:record"
            },
            "kind": {
              "const": "lifecycle-record"
            },
            "byte_length": {
              "minimum": 1,
              "maximum": 2097152
            },
            "schema_identity": {
              "const": "forge.policy-lifecycle/2"
            },
            "validation_profile": {
              "const": "forge.lifecycle-record-intrinsic/1"
            },
            "native_model": {
              "type": "null"
            },
            "native_root_uuid": {
              "type": "null"
            }
          }
        },
        {
          "properties": {
            "artifact_key": {
              "const": "lifecycle:source"
            },
            "kind": {
              "const": "opaque-source"
            },
            "schema_identity": {
              "type": "null"
            },
            "validation_profile": {
              "const": "forge.opaque-source-bytes/1"
            },
            "native_model": {
              "type": "null"
            },
            "native_root_uuid": {
              "type": "null"
            }
          }
        },
        {
          "properties": {
            "artifact_key": {
              "type": "string",
              "pattern": "^lifecycle:generated:(?:[0-9]|[1-8][0-9]|9[0-7])$"
            },
            "kind": {
              "const": "generated-artifact"
            },
            "byte_length": {
              "minimum": 1
            },
            "schema_identity": {
              "type": "null"
            },
            "validation_profile": {
              "const": "forge.lifecycle-generated-identity/1"
            },
            "native_model": {
              "enum": [
                "catalog",
                "profile",
                "component-definition",
                "mapping-collection",
                "system-security-plan",
                "plan-of-action-and-milestones"
              ]
            },
            "native_root_uuid": {
              "$ref": "#/$defs/native_uuid"
            }
          }
        }
      ]
    },
    "SupersessionReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "response_id",
        "raw_sha256"
      ],
      "properties": {
        "response_id": {
          "$ref": "#/$defs/uuid"
        },
        "raw_sha256": {
          "$ref": "#/$defs/hash"
        }
      }
    },
    "ResponseDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "identity_disclaimer",
        "response_id",
        "queue_id",
        "queue_raw_sha256",
        "item_key",
        "item_id",
        "domain",
        "adapter_version",
        "requested_action",
        "source_pins",
        "subject_sha256",
        "context_sha256",
        "policy_sha256",
        "reviewer_key",
        "reviewer_role",
        "disposition",
        "responded_at",
        "rationale",
        "abstention_reason",
        "proposed_edit",
        "supersedes"
      ],
      "properties": {
        "schema_version": {
          "const": "forge.review-response/2"
        },
        "identity_disclaimer": {
          "const": "keys-roles-authors-and-times-are-asserted-not-authenticated-signed-or-non-repudiable"
        },
        "response_id": {
          "$ref": "#/$defs/uuid"
        },
        "queue_id": {
          "$ref": "#/$defs/uuid"
        },
        "queue_raw_sha256": {
          "$ref": "#/$defs/hash"
        },
        "item_key": {
          "$ref": "#/$defs/key"
        },
        "item_id": {
          "$ref": "#/$defs/uuid"
        },
        "domain": {
          "$ref": "#/$defs/Domain"
        },
        "adapter_version": {
          "const": "forge.lifecycle-review/1"
        },
        "requested_action": {
          "$ref": "#/$defs/RequestedAction"
        },
        "source_pins": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourcePin"
          },
          "minItems": 2,
          "maxItems": 100
        },
        "subject_sha256": {
          "$ref": "#/$defs/hash"
        },
        "context_sha256": {
          "$ref": "#/$defs/hash"
        },
        "policy_sha256": {
          "$ref": "#/$defs/hash"
        },
        "reviewer_key": {
          "$ref": "#/$defs/key"
        },
        "reviewer_role": {
          "$ref": "#/$defs/key"
        },
        "disposition": {
          "$ref": "#/$defs/Disposition"
        },
        "responded_at": {
          "$ref": "#/$defs/time"
        },
        "rationale": {
          "type": "string",
          "maxLength": 8192
        },
        "abstention_reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/key"
            },
            {
              "type": "null"
            }
          ]
        },
        "proposed_edit": {
          "type": "null"
        },
        "supersedes": {
          "anyOf": [
            {
              "$ref": "#/$defs/SupersessionReference"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "native_uuid": {
      "type": "string",
      "minLength": 32,
      "maxLength": 45,
      "pattern": "^(?:[0-9A-Fa-f]{32}|[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}|\\{[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}\\}|urn:uuid:[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12})$"
    }
  }
}
