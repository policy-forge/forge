{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://policy-forge.github.io/schemas/suggest-run/1",
  "title": "FORGE suggestion run record",
  "description": "Closed receipt for one local adapter run. It binds the request, the exact payload, the raw response and the adapter identity, and separates measured facts (wall time, exit code) from supplied ones (model identifier, arguments, redaction policy). No network boundary exists to record. Runtime validation additionally rejects decoded duplicate keys, nulls, a non-zero exit code and unsafe paths.",
  "$comment": "Runtime enforces a 256 KiB byte limit, depth 16, a 16 KiB UTF-8 string bound, lowercase SHA-256 digests, at most 32 arguments, at most 64 redactions, a response between 1 and 8388608 bytes, and portable descendant paths. A record is only written for a successful invocation, so exit_code is always 0.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_sha256",
    "payload_sha256",
    "response_sha256",
    "response_bytes",
    "response_artifact",
    "adapter_executable_sha256",
    "model_id",
    "elapsed_ms",
    "exit_code",
    "mode"
  ],
  "properties": {
    "schema_version": {
      "const": "forge.suggest-run/1"
    },
    "request_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "payload_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "response_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "response_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8388608
    },
    "response_artifact": {
      "$ref": "#/$defs/artifact_path"
    },
    "adapter_executable_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "model_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "argv": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "maxLength": 1024
      }
    },
    "redactions": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/redaction"
      }
    },
    "elapsed_ms": {
      "type": "integer",
      "minimum": 0,
      "$comment": "A measured duration, never a timestamp; FORGE reads no clock for identity."
    },
    "exit_code": {
      "const": 0
    },
    "mode": {
      "enum": ["process", "recorded-response"],
      "$comment": "recorded-response names the offline workflow: no process ran and no model was invoked."
    }
  },
  "$defs": {
    "key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifact_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?!.*[\\\\:])[^\\u0000-\\u001f\\u007f]+$"
    },
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit_id", "rule_id", "rule_sha256"],
      "properties": {
        "unit_id": {
          "$ref": "#/$defs/key"
        },
        "rule_id": {
          "$ref": "#/$defs/key"
        },
        "rule_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
